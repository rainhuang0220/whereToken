{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rainhuang0220/whereToken/main/docs/cli-json.schema.json",
  "title": "wheretoken --json",
  "description": "Schema 1 stdout for `wheretoken --json`. Tables stay the default. No events, turns payloads, timestamps, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "period",
    "total",
    "total_m",
    "hit_rate",
    "hit_rate_text",
    "requests",
    "user_turns",
    "tools",
    "vendors",
    "notes"
  ],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "period": { "type": "string" },
    "scope": { "type": "string" },
    "total": { "type": "integer" },
    "total_m": { "type": "string" },
    "hit_rate": { "type": ["number", "null"] },
    "hit_rate_text": { "type": "string" },
    "max_streak_days": { "type": "integer", "minimum": 0 },
    "current_streak_days": { "type": "integer", "minimum": 0 },
    "requests": { "type": "integer", "minimum": 0 },
    "user_turns": { "type": "integer", "minimum": 0 },
    "hide_turns": { "type": "boolean" },
    "last_7d": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 7,
      "maxItems": 7
    },
    "today": { "type": "integer", "minimum": 0 },
    "today_m": { "type": "string" },
    "peak_day": { "type": "integer", "minimum": 0 },
    "peak_day_m": { "type": "string" },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "vendors": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "models": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "cost_status": { "type": "string", "enum": ["complete", "partial", "unavailable"] },
    "cost_usd": { "type": "string" },
    "community": { "$ref": "#/$defs/community" }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "total", "total_m", "hit_rate_text", "requests"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "total": { "type": "integer" },
        "total_m": { "type": "string" },
        "share": { "type": "string" },
        "hit_rate_text": { "type": "string" },
        "requests": { "type": "integer", "minimum": 0 },
        "user_turns": { "type": "integer", "minimum": 0 },
        "cost_status": { "type": "string", "enum": ["complete", "partial", "unavailable"] },
        "cost_usd": { "type": "string" }
      }
    },
    "community": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "metric": { "type": "string" },
        "self_reported": { "type": "boolean" },
        "note": { "type": "string" },
        "today": { "$ref": "#/$defs/standing" },
        "all": { "$ref": "#/$defs/standing" }
      }
    },
    "standing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable",
            "not_ranked",
            "insufficient_participants",
            "opted_out",
            "offline",
            "disabled",
            "no_usage",
            "service_unconfigured",
            "network_error"
          ]
        },
        "period": { "type": "string" },
        "metric": { "type": "string" },
        "rank": { "type": "integer", "minimum": 1 },
        "participants": { "type": "integer", "minimum": 1 },
        "percentile": { "type": "number" },
        "top_share": { "type": "number" },
        "display": { "type": "string" },
        "note": { "type": "string" },
        "self_reported": { "type": "boolean" }
      }
    }
  }
}
