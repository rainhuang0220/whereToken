# Copy to /home/ubuntu/wheretoken/shared/.env (mode 0600).
# Never commit the real file.

WHERETOKEN_LISTEN=127.0.0.1:3400
WHERETOKEN_PUBLIC_URL=https://wheretoken.plainlist.space
WHERETOKEN_GITHUB_CLIENT_ID=
WHERETOKEN_GITHUB_CLIENT_SECRET=
WHERETOKEN_MYSQL_DSN=wheretoken_app:PASSWORD@tcp(127.0.0.1:3306)/wheretoken?parseTime=true&charset=utf8mb4
WHERETOKEN_COOKIE_SECURE=1

# Optional. Leave unset until the GitHub App is installed.
# Permissions: Metadata read, Contents read/write.
# Installation repositories: the profile repo only.
# WHERETOKEN_GITHUB_APP_ID=
# WHERETOKEN_GITHUB_APP_INSTALLATION_ID=
# WHERETOKEN_GITHUB_APP_PRIVATE_KEY_FILE=/home/ubuntu/wheretoken/shared/github-app.pem
# WHERETOKEN_PROFILE_REPO=rainhuang0220/rainhuang0220
# WHERETOKEN_PROFILE_BRANCH=main
# WHERETOKEN_PROFILE_README=README.md
# WHERETOKEN_PROFILE_PREVIEW_DIR=wheretoken
# WHERETOKEN_PUBLIC_PROFILE_ORIGINS=https://rainhuang0220.github.io
